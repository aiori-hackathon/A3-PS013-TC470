# Copy this file to `.env` and fill in real values for your environment.
# Never commit the real `.env` file (see .gitignore).

# PostgreSQL connection string. Defaults to a local SQLite file if unset --
# see app/config.py. Example for the local portable Postgres instance used
# in development (see PROGRESS.md Phase 1):
DATABASE_URL=postgresql+asyncpg://cybertrace:cybertrace@localhost:5433/cybertrace

# Must be a long, random, unguessable value in any non-local environment --
# anyone with this secret can forge valid JWTs for any user.
JWT_SECRET_KEY=change-me-to-a-long-random-value

EVIDENCE_STORAGE_DIR=./storage/evidence
REPORTS_STORAGE_DIR=./storage/reports
