# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

# --- Backend ---
# PostgreSQL (preferred). For local dev without PostgreSQL, you can instead
# use: sqlite+aiosqlite:///./cybertrace.db
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5433/cybertrace

JWT_SECRET_KEY=change-this-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

EVIDENCE_STORAGE_DIR=./storage/evidence
MAX_UPLOAD_SIZE_BYTES=209715200

CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

LOGIN_RATE_LIMIT=10/minute

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
